# Campaign backend used by the production coupon service (HttpCouponService).
# Leave empty to stay in demo mode, where coupons are generated locally and are
# clearly marked "DEMO — NOT REDEEMABLE".
VITE_API_URL=

# Base URL that QR codes point at: {VITE_COUPON_BASE_URL}/{token}
VITE_COUPON_BASE_URL=https://campaign.example.com/claim

# Campaign landing page opened by the "Campaign site" button.
VITE_CAMPAIGN_URL=https://campaign.example.com/itoen-catch

# Show the hitbox / tracking overlay from boot (operators can also press Ctrl+Alt+D).
VITE_ENABLE_DEBUG_BY_DEFAULT=false
